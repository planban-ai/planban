{
  "name": "planban",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "planban": "./bin/planban.mjs"
  },
  "scripts": {
    "dev": "tsx src/cli.ts serve",
    "planban": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test-concurrency=1 --import tsx/esm --test tests/*.test.ts",
    "build": "vite build",
    "preview": "tsx src/cli.ts serve --no-vite",
    "smoke": "npm run build && tsx scripts/smoke.ts",
    "release:preflight": "node scripts/preflight-release.mjs",
    "release:upgrade-rehearsal": "node scripts/rehearse-release-upgrade.mjs",
    "release:claude-upgrade-rehearsal": "node scripts/rehearse-claude-code-upgrade.mjs",
    "update:benchmark": "node scripts/rehearse-marketplace-update-performance.mjs",
    "plugin:configure": "node scripts/configure-local-plugin.mjs",
    "planban:demo": "node --import tsx/esm src/cli.ts demo"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@vitejs/plugin-react": "^6.0.2",
    "chokidar": "^4.0.3",
    "commander": "^14.0.2",
    "convex": "^1.46.0",
    "express": "^5.2.1",
    "lucide-react": "^0.561.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-string": "^4.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.21.0",
    "vite": "^8.0.16",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "fflate": "^0.8.3",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
